---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

// Six items that used to be an array of objects in this file, each with its
// own image import at the top. Adding a seventh meant editing a page.
const posts = (await getCollection('news')).sort((a, b) => a.data.order - b.data.order);

const thumbSizes = '(max-width: 820px) 92vw, 30vw';
---
<Layout
  title={`News & Events - ${site.name}`}
  description="The latest news and events from Mt Cedar British International School, Benin City - admissions updates, celebrations and pupil achievements."
  active="news"
>

<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">News &amp; Events</p>
    <h1>Life at Mt Cedar.</h1>
    <p>Celebrations, milestones and everyday moments from our school community.</p>
  </div>
</section>

<section class="news news-page">
  <div class="wrap">
    <div class="grid3">
      {posts.map((post) => (
        <article class="ncard">
          <div class="thumb">
            <Image src={post.data.cover} alt={post.data.coverAlt} widths={[400, 640, 900]} sizes={thumbSizes} format="webp" quality={72} loading="lazy" />
          </div>
          <div class="body">
            <span class="tag">{post.data.tag}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <p class="eyebrow" style="color:var(--accent-300)">Stay close to the school</p>
    <h2>Want to be part of it?</h2>
    <p>Admissions for 2026/2027 are open. Arrange a visit and see the Mt Cedar community for yourself.</p>
    <div class="cta">
      <a class="btn btn-gold btn-lg" href="/admissions">Explore Admissions <span class="arr">→</span></a>
      <a class="btn btn-ghost btn-lg" href="/contact">Contact Us</a>
    </div>
  </div>
</section>

</Layout>
