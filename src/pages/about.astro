---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
import { getCollection } from 'astro:content';
import Icon from '../system/components/Icon.astro';
import MediaText from '../system/blocks/Media/Text.astro';
import Facilities from '../system/blocks/Feature/Grid.astro';
import { Image } from 'astro:assets';
import headPhoto from '../assets/images/head-of-school.jpg';
import storyPhoto from '../assets/images/culturalattireday.jpg';

// The same three values the homepage shows, from the same files.
const values = (await getCollection('values')).sort((a, b) => a.data.order - b.data.order);
---
<Layout
  title={`About - ${site.name}`}
  description="Meet Mt Cedar British International School: our philosophy, our values, and the story behind a new school in the Obaretin community of Benin City, combining British EYFS and Montessori with the Nigerian Curriculum enriched with Cambridge."
  active="about"
>

<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">About the School</p>
    <h1>An education that shapes the whole child.</h1>
    <p>A new and vibrant school in the Obaretin community of Benin City, offering a safe, caring and stimulating environment. Grounded in strong values and reaching for real academic excellence, Mt Cedar gives children deep roots and room to rise.</p>
  </div>
</section>

<section class="welcome">
  <div class="wrap">
    <div class="photo">
      <Image src={headPhoto} alt="The Head of School at Mt Cedar British International School" widths={[480, 768, 1100]} sizes="(max-width: 820px) 92vw, 46vw" format="webp" quality={76} loading="lazy" />
    </div>
    <div>
      <p class="eyebrow">Welcome to Mt Cedar</p>
      <h2>A warm word from the Head of School.</h2>
      <blockquote>“Like the cedar it is named for, our school is built to give children deep roots and room to rise: grounded in strong values, reaching for real academic excellence.”</blockquote>
      <div class="signoff">The Head of School<small>Mt Cedar British International School</small></div>
    </div>
  </div>
</section>

<MediaText
  image={storyPhoto}
  alt="Mt Cedar pupils celebrating cultural attire day"
  eyebrow="Our Story"
  title="Named for the cedar - rooted deep, reaching high."
  reverse={true}
>
  <p>Mt Cedar British International School was founded on a simple conviction: that children flourish when high academic expectations are matched by genuine care for who they are becoming. We take our name from the cedar; a tree prized for standing firm through every season while growing tall and strong.</p>
  <p>Set in the Obaretin community of Ikpoba-Okha, Benin City, close to Rubber Research Junction, we offer a safe, caring and stimulating environment at every stage. In the Nursery we combine the British EYFS with Montessori education. From Primary through Senior Secondary we teach the Nigerian Curriculum enriched with Cambridge, in small, focused classes led by caring teachers.</p>
  <p>Alongside high academic standards we teach the values that outlast an examination: honesty, kindness and courage, the character that shapes the next generation of leaders.</p>
  <div class="cta">
    <a class="btn btn-brand" href="/admissions">Explore Admissions <span class="arr">→</span></a>
    <a class="btn btn-outline" href="/contact">Arrange a Visit</a>
  </div>
</MediaText>

<section class="values" style="background:var(--surface-2)">
  <div class="wrap">
    <div class="sec-head"><p class="eyebrow">Our Promise</p><h2>Three commitments, on our crest and in our classrooms.</h2><p>The emblems on our shield are not decoration; they name what we set out to give every child who joins us.</p></div>
    <div class="values-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;margin-top:2.6rem">
      {values.map((value) => (
        <div class="vcard">
          <div class="ic"><Icon name={value.data.icon} /></div>
          <h3>{value.data.title}</h3>
          <p>{value.data.summary}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<Facilities
  title="A campus equipped for the promise we make."
  intro="Well equipped Biology, Chemistry, Physics and Computer laboratories, a music studio, a library, an art and craft studio and sports facilities: the practical side of Excellence, Character and Growth."
/>

<section class="band">
  <div class="wrap">
    <p class="eyebrow" style="color:var(--accent-300)">Admissions Open</p>
    <h2>Come and see where your child will grow.</h2>
    <p>Applications for the 2026/2027 session are open from Nursery through Primary to Senior Secondary. Arrange a visit and feel the Mt Cedar difference in person.</p>
    <div class="cta">
      <a class="btn btn-gold btn-lg" href="/admissions">Start an Enquiry <span class="arr">→</span></a>
      <a class="btn btn-ghost btn-lg" href="/contact">Contact the School</a>
    </div>
  </div>
</section>

</Layout>
