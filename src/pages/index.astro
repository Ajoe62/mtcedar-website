---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
import HeroCarousel from '../components/HeroCarousel.astro';
import Facilities from '../components/Facilities.astro';
import { portalHref } from '../config/integrations';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Icon from '../system/components/Icon.astro';

// The hero's primary action goes straight to ResultPeak's applicant
// registration. Falls back to the admissions page out of season, so the most
// prominent button on the site never points at a closed form.
const applyHref = portalHref('entrance') ?? '/admissions';
const applyAttrs = applyHref.startsWith('http') ? { rel: 'noopener' } : {};
import welcomePhoto from '../assets/images/teacher-pupil-connection.jpg';

const thumbSizes = '(max-width: 820px) 92vw, 30vw';

const values = (await getCollection('values')).sort((a, b) => a.data.order - b.data.order);

// The homepage shows the three most recent; /news shows all of them. One
// source, two views, so the two can never drift apart the way two hand
// maintained lists do.
const latestNews = (await getCollection('news'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---
<Layout
  title={`${site.name}, ${site.address.city}`}
  active=""
>

<HeroCarousel>
  <h1>Where character takes root and <em>excellence</em> grows.</h1>
  <div class="cta">
    <a class="btn btn-gold btn-lg" href={applyHref} {...applyAttrs}>Begin an Application <span class="arr">→</span></a>
    <a class="btn btn-ghost btn-lg" href="/about">Discover the School</a>
  </div>
</HeroCarousel>

<div class="facts">
  <div class="wrap">
    <div class="f"><b>EYFS + Cambridge</b><span>Curriculum</span></div>
    <div class="f"><b>Nursery to SS3</b><span>Every Stage</span></div>
    <div class="f"><b>Benin City</b><span>Edo State</span></div>
    <div class="f"><b>Open</b><span>Admissions 2026</span></div>
  </div>
</div>

<section class="welcome">
  <div class="wrap">
    <div class="photo">
      <Image src={welcomePhoto} alt="A Mt Cedar teacher supporting a pupil in class" widths={[480, 768, 1100]} sizes="(max-width: 820px) 92vw, 46vw" format="webp" quality={74} loading="lazy" />
    </div>
    <div>
      <p class="eyebrow">Welcome to Mt Cedar</p>
      <h2>An education that shapes the whole child.</h2>
      <blockquote>“Like the cedar it is named for, our school is built to give children deep roots and room to rise: grounded in strong values, reaching for real academic excellence.”</blockquote>
      <div class="signoff">The Head of School<small>Mt Cedar British International School</small></div>
      <div class="cta" style="margin-top:1.6rem">
        <a class="btn btn-brand" href="/about">Read our story <span class="arr">→</span></a>
      </div>
    </div>
  </div>
</section>

<section class="values">
  <div class="wrap">
    <div class="sec-head"><p class="eyebrow">Our Promise</p><h2>Three commitments, on our crest and in our classrooms.</h2><p>The emblems on our shield are not decoration, they name what we set out to give every child who joins us.</p></div>
    <div class="values-grid">
      {values.map((value) => (
        <div class="vcard">
          <div class="ic"><Icon name={value.data.icon} /></div>
          <h3>{value.data.title}</h3>
          <p>{value.data.summary}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<Facilities
  background="var(--surface-2)"
  intro="Well equipped Biology, Chemistry, Physics and Computer laboratories, a music studio, sports facilities and more: the tools that turn lessons into real experience."
/>

<section class="portal-strip">
  <div class="wrap">
    <div>
      <p class="eyebrow">Mt Cedar Portal</p>
      <h2>Assessments and lessons, online.</h2>
      <p>Students sign in with a username and access code issued by the school. There is no account to create, no password to forget. Lessons keep working when the data runs out.</p>
    </div>
    <div class="cta">
      <a class="btn btn-brand" href="/portal">Open the Portal <span class="arr">→</span></a>
      <a class="btn btn-outline" href="/portal/help">Sign-in Guide</a>
    </div>
  </div>
</section>

<section class="news">
  <div class="wrap">
    <div class="top">
      <div class="sec-head"><p class="eyebrow">News &amp; Events</p><h2>Life at Mt Cedar.</h2></div>
      <a class="btn btn-brand" href="/news">View all news <span class="arr">→</span></a>
    </div>
    <div class="grid3">
      {latestNews.map((post) => (
        <article class="ncard"><div class="thumb"><Image src={post.data.cover} alt={post.data.coverAlt} widths={[400, 640, 900]} sizes={thumbSizes} format="webp" quality={72} loading="lazy" /></div><div class="body"><span class="tag">{post.data.tag}</span><h3>{post.data.title}</h3><p>{post.data.summary}</p></div></article>
      ))}
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <p class="eyebrow" style="color:var(--accent-300)">Admissions Open</p>
    <h2>Come and see where your child will grow.</h2>
    <p>Applications for the 2026/2027 session are open from Nursery through Primary to Senior Secondary. Arrange a visit, meet our teachers, and feel the Mt Cedar difference in person.</p>
    <div class="cta">
      <a class="btn btn-gold btn-lg" href="/admissions">Start an Enquiry <span class="arr">→</span></a>
      <a class="btn btn-ghost btn-lg" href="/contact">Contact the School</a>
    </div>
  </div>
</section>

</Layout>
