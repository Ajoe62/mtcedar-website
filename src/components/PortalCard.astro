---
/**
 * One entry point on the portal hub.
 *
 * Renders as a link when the destination is live and as an inert card when it
 * is not, so a page can list every future entry point without ever handing a
 * student a broken link. Built on the existing .feat card (enhance.css) so it
 * inherits the site's hover lift, icon tile and mobile stacking.
 */
interface Props {
  title: string;
  href?: string | null;
  action?: string;
  meta?: string;
  external?: boolean;
}

const { title, href = null, action = 'Open', meta, external = true } = Astro.props;
const live = Boolean(href);
const Tag = live ? 'a' : 'div';
const attrs = live
  ? { href, ...(external ? { rel: 'noopener' } : {}) }
  : { 'aria-disabled': 'true' };
---
<Tag class={`feat pcard-link${live ? '' : ' is-pending'}`} {...attrs}>
  <div class="ic"><slot name="icon" /></div>
  <h3>{title}</h3>
  <p><slot /></p>
  {meta && <p class="pcard-meta">{meta}</p>}
  <p class="pcard-action">
    {live ? <>{action} <span class="arr">→</span></> : <>Opening soon</>}
  </p>
</Tag>

<style>
  .pcard-link {
    display: block;
    height: 100%;
  }
  .pcard-link.is-pending {
    opacity: 0.72;
    background: transparent;
    border-style: dashed;
  }
  .pcard-link.is-pending:hover {
    transform: none;
    box-shadow: none;
  }
  .pcard-meta {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--cedar);
    background: rgba(195, 150, 48, 0.12);
    border-radius: 8px;
    padding: 0.5rem 0.7rem;
    margin-top: 0.9rem;
  }
  .pcard-action {
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--cedar);
    margin-top: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .is-pending .pcard-action {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
  }
  .pcard-link .arr {
    transition: transform 0.2s ease;
  }
  .pcard-link:hover .arr {
    transform: translateX(4px);
  }
</style>
