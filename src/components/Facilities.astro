---
interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  background?: string;
}

const {
  eyebrow = 'Our Facilities',
  title = 'Well-equipped spaces for real learning.',
  intro = 'Good teaching deserves good tools. Our laboratories, studios, library and grounds give pupils the space and equipment to learn by doing.',
  background,
} = Astro.props;
---
<section class="facilities" style={background ? `background:${background}` : undefined}>
  <div class="wrap">
    <div class="sec-head"><p class="eyebrow">{eyebrow}</p><h2>{title}</h2><p>{intro}</p></div>
    <div class="feat-grid">
      <div class="feat">
        <div class="ic"><svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 2v6.2L3.8 17A2 2 0 0 0 5.5 20h13a2 2 0 0 0 1.7-3L15 8.2V2"/><path d="M8 2h8"/><path d="M6.4 14h11.2"/></svg></div>
        <h3>Science Laboratories</h3>
        <p>Well-equipped Biology, Chemistry and Physics laboratories where pupils handle real apparatus and learn science by doing, not just reading.</p>
      </div>
      <div class="feat">
        <div class="ic"><svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="4" width="19" height="12.5" rx="2"/><path d="M8 20h8"/><path d="M12 16.5V20"/><path d="m9.5 8.5-2 1.7 2 1.8"/><path d="m14.5 8.5 2 1.7-2 1.8"/></svg></div>
        <h3>Computer Laboratory</h3>
        <p>A fully equipped computer lab for ICT lessons, coding and research - building digital confidence from primary through secondary.</p>
      </div>
      <div class="feat">
        <div class="ic"><svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3Z"/></svg></div>
        <h3>Music Studio</h3>
        <p>A dedicated music studio with instruments and equipment for lessons, practice, choir and performance, every child gets to make music.</p>
      </div>
      <div class="feat">
        <div class="ic"><svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 3a15 15 0 0 0 0 18M12 3a15 15 0 0 1 0 18M3 12h18"/></svg></div>
        <h3>Sports Facilities</h3>
        <p>Playing grounds and sporting equipment for athletics, football and physical education room to run, compete and build teamwork.</p>
      </div>
      <div class="feat">
        <div class="ic"><svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 19V5a2 2 0 0 1 2-2h11a1 1 0 0 1 1 1v13"/><path d="M6 17h12v4H6a2 2 0 0 1 0-4Z"/></svg></div>
        <h3>Library &amp; Reading Room</h3>
        <p>A well-stocked library and quiet reading spaces that support research, independent study and a genuine love of reading.</p>
      </div>
      <div class="feat">
        <div class="ic"><svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3a9 9 0 0 0 0 18c1.4 0 2-.9 2-1.8 0-1.5-1.3-1.7-1.3-2.9 0-.9.7-1.5 1.7-1.5H16a5 5 0 0 0 5-5c0-3.7-4-6.8-9-6.8Z"/><circle cx="8" cy="10" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16" cy="10" r="1"/></svg></div>
        <h3>Art &amp; Craft Studio</h3>
        <p>Creative studio space and materials for drawing, painting and craft, where imagination takes a visible shape.</p>
      </div>
    </div>
  </div>
</section>
